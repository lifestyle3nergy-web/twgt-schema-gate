{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestyle3nergy-web.github.io/twgt-schema-gate/schemas/v1/agent-request.json",
  "title": "AgentRequest",
  "type": "object",
  "required": ["request_id", "issued_at", "source", "capability", "payload", "trace_context"],
  "properties": {
    "request_id":      { "type": "string", "format": "uuid" },
    "issued_at":       { "type": "string", "format": "date-time" },
    "source":          { "type": "string", "minLength": 1 },
    "capability":      { "type": "string", "minLength": 1 },
    "payload":         { "type": "object" },
    "trace_context":   { "$ref": "common/trace-context.json" },
    "deadline_ms":     { "type": "integer", "minimum": 1 },
    "policy_decision": { "$ref": "common/policy-decision.json" }
  },
  "additionalProperties": false
}
