{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestyle3nergy-web.github.io/twgt-schema-gate/schemas/v1/agent-response.json",
  "title": "AgentResponse",
  "type": "object",
  "required": ["request_id", "completed_at", "status"],
  "properties": {
    "request_id":   { "type": "string", "format": "uuid" },
    "completed_at": { "type": "string", "format": "date-time" },
    "status":       { "enum": ["ok", "error", "partial"] },
    "result":       { "type": "object" },
    "error":        { "type": "string" },
    "provenance":   { "$ref": "common/provenance.json" }
  },
  "additionalProperties": false
}
