{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lifestyle3nergy-web.github.io/twgt-schema-gate/schemas/v1/evidence-batch.json",
  "title": "TWGT Bridge Evidence Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "batch"],
  "properties": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "checks"],
      "properties": {
        "state": { "type": "string", "enum": ["COLLECTED", "VALIDATED", "ADMITTED", "HELD"] },
        "reason": { "type": "string", "minLength": 1 },
        "checks": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["state", "reason"],
            "properties": {
              "state": { "type": "string", "enum": ["VALIDATED", "HELD", "COLLECTED", "ADMITTED"] },
              "reason": { "type": "string", "minLength": 1 },
              "detail": {}
            }
          }
        },
        "detail": {}
      }
    },
    "batch": {
      "type": "object", "additionalProperties": false,
      "required": ["bridge_version", "collected_at", "source", "entries"],
      "properties": {
        "bridge_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "collected_at": { "type": "string", "format": "date-time" },
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["owner", "repo"],
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "repo": { "type": "string", "minLength": 1 }
          }
        },
        "entries": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["name", "ok"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "ok": { "type": "boolean" },
              "record": {},
              "error": {}
            }
          }
        }
      }
    }
  }
}
