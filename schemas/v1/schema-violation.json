{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestyle3nergy-web.github.io/twgt-schema-gate/schemas/v1/schema-violation.json",
  "title": "SchemaViolationEvent",
  "type": "object",
  "required": [
    "event_id", "timestamp", "schema_id", "schema_version",
    "direction", "source", "target", "violations",
    "payload_hash", "payload_size", "severity"
  ],
  "properties": {
    "event_id":       { "type": "string", "format": "uuid" },
    "timestamp":      { "type": "string", "format": "date-time" },
    "schema_id":      { "type": "string", "format": "uri" },
    "schema_version": { "type": "string" },
    "direction":      { "enum": ["input", "output", "internal"] },
    "source":         { "type": "string", "minLength": 1 },
    "target":         { "type": "string", "minLength": 1 },
    "violations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "keyword", "message"],
        "properties": {
          "path":    { "type": "string" },
          "keyword": { "type": "string" },
          "message": { "type": "string" },
          "params":  { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "payload_hash":    { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload_size":    { "type": "integer", "minimum": 0 },
    "trace_context":   { "$ref": "common/trace-context.json" },
    "policy_decision": { "$ref": "common/policy-decision.json" },
    "severity":        { "enum": ["warn", "error", "fatal"] }
  },
  "additionalProperties": false
}
