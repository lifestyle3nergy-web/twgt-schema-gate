{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestyle3nergy-web.github.io/twgt-schema-gate/schemas/v1/tool-result.json",
  "title": "ToolResult",
  "type": "object",
  "required": ["invocation_id", "completed_at", "status"],
  "properties": {
    "invocation_id": { "type": "string", "format": "uuid" },
    "completed_at":  { "type": "string", "format": "date-time" },
    "status":        { "enum": ["ok", "error", "timeout"] },
    "output":        { "type": "object" },
    "error":         { "type": "string" },
    "duration_ms":   { "type": "integer", "minimum": 0 },
    "provenance":    { "$ref": "common/provenance.json" }
  },
  "additionalProperties": false
}
